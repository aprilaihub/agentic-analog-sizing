include LICENSE README.md CHANGELOG.md CITATION.cff CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md
recursive-include docs *.md
exclude docs/toThinkList.md docs/todolist.md
recursive-include src/agentic_sizing/resources/prompts *.md
recursive-include src/agentic_sizing *.schema.json *.example.json
recursive-include examples *.py *.json
recursive-include input *
prune output
prune agentic_sizing
global-exclude .env* *.py[cod] __pycache__ *.rdb *.raw simResults*.csv
