{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analog-ic-agentic/agentic-sizing/kb-role-perf.schema.json",
  "title": "Agentic Sizing KB Functional Role Performance",
  "type": "object",
  "additionalProperties": false,
  "required": ["facts"],
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "functional_role",
          "metric",
          "influence",
          "confidence",
          "evidence_count",
          "evidence_iters",
          "topology"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["role_perf"]
          },
          "functional_role": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "influence": {
            "type": "string",
            "enum": ["dominant", "significant", "weak"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_iters": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "topology": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
